# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_DATABASE=arreglalo_ya_db

# Configuración de Seguridad JWT
JWT_SECRET=clave_secreta_muy_larga_y_segura_para_produccion
JWT_EXPIRES_IN=7d

# Puerto del servidor Backend (API REST)
PORT=3000

# Orígenes CORS permitidos (separados por comas)
# CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Observability (NestJS Observe) — opcional
# OBSERVE_APP_KEY=tu_app_key
# OBSERVE_APP_SECRET=tu_app_secret

# Archivo de configuración de la plataforma (opcional, por defecto: storage/configuracion.json)
# CONFIGURACION_ARCHIVO=storage/configuracion.json